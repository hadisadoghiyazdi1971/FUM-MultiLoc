{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FUM-MultiLoc visual observation index",
  "type": "object",
  "required": ["vision_ref", "session_id", "timestamp_ns"],
  "properties": {
    "vision_ref": {"type": "string"},
    "session_id": {"type": "string"},
    "timestamp_ns": {"type": "integer"},
    "archive": {"type": ["string", "null"]},
    "path": {"type": ["string", "null"]},
    "camera_id": {"type": ["string", "null"]},
    "width_px": {"type": ["integer", "null"]},
    "height_px": {"type": ["integer", "null"]},
    "privacy_reviewed": {"type": ["boolean", "null"]}
  },
  "additionalProperties": true
}
